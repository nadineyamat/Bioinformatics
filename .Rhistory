head(names(metazoa_alignment))
# 1. Load the specific gene/species
target_dna <- metazoa_alignment[["Homo_sapiens"]]
# 2. Translate (using 'solve' to handle those alignment gaps)
protein_seq <- translate(target_dna, if.fuzzy.codon="solve")
# 1. Remove anything that isn't a standard DNA base (A, T, G, C, N or -)
# This gets rid of periods (.) or weird symbols that cause the "not a base" error
target_dna_clean <- DNAString(gsub("[^ATGCN-]", "", as.character(target_dna)))
# 2. Now translate
protein_seq <- translate(target_dna_clean, if.fuzzy.codon="solve")
# 1. Convert to character and swap ALL non-bases (including - and .) to N
# This satisfies the "not a base" error without changing the sequence length
target_dna_n <- DNAString(gsub("[^ATGC]", "N", as.character(target_dna)))
# 2. Now translate using solve
# Every 'NNN' or '---' will now become an 'X' in your protein
protein_seq <- translate(target_dna_n, if.fuzzy.codon="solve")
# 3. View your result
as.character(protein_seq)
